# Copy to .env on the server and fill in. Never commit .env.
DB_PASSWORD=choose-a-long-password
JWT_SECRET=choose-a-long-random-string
PUBLIC_BASE_URL=http://201.18.215.113:8100
ALLOW_FAKE_CONFIRM=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Website and https. Fill these in when you have a domain (see README, 'Website on your VPS').
# Example: WEB_DOMAIN=hillbooker.com  API_DOMAIN=api.hillbooker.com
WEB_DOMAIN=
API_DOMAIN=
# Websites allowed to call the API (comma separated). With a domain: https://hillbooker.com,https://www.hillbooker.com
CORS_ORIGINS=http://201.18.215.113:3100

# Invoices: the business details print on every invoice.
BUSINESS_NAME=Hill Booker
BUSINESS_ADDRESS=
BUSINESS_EMAIL=
BUSINESS_PHONE=
# Email for sending invoices. Leave SMTP_HOST empty to keep email off (guests can still open the invoice).
# Example with a hosting mailbox: SMTP_HOST=smtp.hostinger.com SMTP_PORT=465 SMTP_SECURITY=ssl
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Hill Booker <bookings@hillbooker.com>
SMTP_SECURITY=starttls

# Sign in with Google (leave empty to hide the button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SITE_URL=https://hillbooker.com
