DATABASE_URL=postgresql://roomly:roomly@localhost:5432/roomly
JWT_SECRET=change-this-to-a-long-random-string
HOLD_MINUTES=10
ALLOW_FAKE_CONFIRM=true
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8000
MAX_UPLOAD_MB=5
MAX_PHOTOS_PER_ITEM=20

# Razorpay: use the TEST keys while building (they start with rzp_test_). Leave empty to keep payments off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Full refund when cancelling at least this many hours before check-in; no refund after that.
REFUND_FULL_HOURS=48
